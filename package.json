{
  "name": "opencode-model-refresh",
  "version": "1.0.0",
  "description": "Multi-provider OpenCode plugin that reconciles model pickers with live provider APIs through per-provider adapters.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a2way-com/opencode-model-refresh.git"
  },
  "homepage": "https://github.com/a2way-com/opencode-model-refresh#readme",
  "bugs": {
    "url": "https://github.com/a2way-com/opencode-model-refresh/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./src/tui.tsx",
